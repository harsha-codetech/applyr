{
  "id": "ashby",
  "name": "Ashby",
  "match": [
    "jobs.ashbyhq.com",
    "ashbyhq.com"
  ],
  "verifiedAgainstLiveForm": "2026-09-18",
  "notes": [
    "Only name, email and resume are true system fields. Phone, location and every link",
    "field are per-employer custom fields whose name and id are a bare UUID, so they",
    "cannot be targeted by a pack at all - generic mode answers them from their labels.",
    "The resume input carries id=_systemfield_resume but no name attribute.",
    "A bare input[type=file] fallback is deliberately NOT used here: the first file input",
    "on the page is the 'autofill from resume' uploader at the top of the form, and a",
    "fallback would attach the resume to the wrong control.",
    "EEO answers are radio groups named <uuid>__systemfield_eeoc_<x>, matched by suffix."
  ],
  "detect": {
    "any": [
      "#ashby-application-form-container",
      "input[name='_systemfield_name']",
      "[class*='ashby-application-form']",
      "form[class*='ashby']"
    ]
  },
  "meta": {
    "company": [
      "[class*='ashby-job-posting-brief'] img[alt]",
      "meta[property='og:site_name']"
    ],
    "role": [
      "h1",
      "[class*='job-posting-header'] h1",
      "meta[property='og:title']"
    ]
  },
  "submit": [
    "[class*='ashby-application-form-submit-button']",
    "button[type='submit']"
  ],
  "confirm": [
    "[class*='application-confirmation']",
    "[class*='ashby-application-success']"
  ],
  "widgets": {
    "combobox": {
      "trigger": "[role='combobox'], [class*='_select_'], [class*='ashby-select']",
      "option": "[role='option'], [class*='_option_']",
      "input": "input[role='combobox']"
    }
  },
  "fields": [
    {
      "id": "full_name",
      "selector": [
        "input[name='_systemfield_name']",
        "#_systemfield_name"
      ]
    },
    {
      "id": "email",
      "selector": [
        "input[name='_systemfield_email']",
        "#_systemfield_email"
      ]
    },
    {
      "id": "phone",
      "selector": [
        "input[name='_systemfield_phone']",
        "#_systemfield_phone"
      ]
    },
    {
      "id": "full_address",
      "selector": [
        "input[name='_systemfield_location']",
        "#_systemfield_location"
      ]
    },
    {
      "id": "resume_file",
      "selector": [
        "input[type='file']#_systemfield_resume",
        "input[type='file'][id*='resume' i]",
        "input[type='file'][name='_systemfield_resume']"
      ]
    },
    {
      "id": "linkedin_url",
      "selector": [
        "input[name*='linkedin' i]",
        "input[id*='linkedin' i]"
      ]
    },
    {
      "id": "github_url",
      "selector": [
        "input[name*='github' i]",
        "input[id*='github' i]"
      ]
    },
    {
      "id": "portfolio_url",
      "selector": [
        "input[name*='website' i]",
        "input[name*='portfolio' i]"
      ]
    },
    {
      "id": "eeo_gender",
      "selector": [
        "input[type='radio'][name$='__systemfield_eeoc_gender']",
        "select[name$='__systemfield_eeoc_gender']"
      ]
    },
    {
      "id": "eeo_race",
      "selector": [
        "input[type='radio'][name$='__systemfield_eeoc_race']",
        "select[name$='__systemfield_eeoc_race']"
      ]
    },
    {
      "id": "eeo_veteran",
      "selector": [
        "input[type='radio'][name$='__systemfield_eeoc_veteran_status']",
        "select[name$='__systemfield_eeoc_veteran_status']"
      ]
    },
    {
      "id": "eeo_disability",
      "selector": [
        "input[type='radio'][name$='__systemfield_eeoc_disability_status']",
        "select[name$='__systemfield_eeoc_disability_status']"
      ]
    }
  ]
}
